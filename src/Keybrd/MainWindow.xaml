<Window x:Class="Keybrd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренажер клавіатури"
        Icon="Assets/app.ico"
        Width="1100" Height="720" MinWidth="820" MinHeight="560"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок вікна -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" FontSize="14"
                        Click="ThemeButton_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Згорнути"
                        Click="Minimize_Click"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Розгорнути"
                        Click="Maximize_Click"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Закрити"
                        Click="Close_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="Assets/app.ico" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Тренажер клавіатури" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Вкладки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,6,12,4">
            <RadioButton x:Name="TabTraining" Style="{StaticResource TabRadio}" GroupName="Tabs" Tag="training"
                         Content="Тренування" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabLessons" Style="{StaticResource TabRadio}" GroupName="Tabs" Tag="lessons"
                         Content="Уроки" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabStats" Style="{StaticResource TabRadio}" GroupName="Tabs" Tag="stats"
                         Content="Статистика" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabSettings" Style="{StaticResource TabRadio}" GroupName="Tabs" Tag="settings"
                         Content="Налаштування" Checked="Tab_Checked"/>
        </StackPanel>

        <!-- Інформаційна смужка (наприклад, «конфіг пошкоджено») -->
        <Border x:Name="InfoBar" Grid.Row="2" Margin="16,6,16,0" CornerRadius="6" Padding="14,8"
                Background="{DynamicResource InfoBgBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="28" Height="24"
                        Foreground="{DynamicResource InfoFgBrush}" Content="&#xE8BB;" ToolTip="Сховати"
                        Click="InfoClose_Click"/>
                <Button x:Name="InfoAction" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="12,0,8,0"
                        Visibility="Collapsed" Click="InfoAction_Click"/>
                <TextBlock x:Name="InfoText" Foreground="{DynamicResource InfoFgBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="3" Margin="16,12,16,16" Focusable="False"/>
    </Grid>
</Window>
