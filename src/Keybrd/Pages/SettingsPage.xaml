<UserControl x:Class="Keybrd.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="Hotkey" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource KeyBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource KeyBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,10,8">

            <!-- Вигляд -->
            <TextBlock Text="Вигляд" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Тема" FontWeight="SemiBold"/>
                    <TextBlock Text="Ctrl+T або кнопка в заголовку швидко перемикають світлу й темну."
                               Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource OptionRadio}" GroupName="Theme"
                                     Tag="light" Content="Світла" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource OptionRadio}" GroupName="Theme"
                                     Tag="dark" Content="Темна" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource OptionRadio}" GroupName="Theme"
                                     Tag="system" Content="Як у Windows" Checked="Theme_Checked"/>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Text="Акцентний колір" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccentName" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                    <WrapPanel x:Name="AccentPanel"/>

                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel>
                        <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Розмір тексту вправи" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Slider x:Name="FontSizeSlider" Style="{StaticResource FluentSlider}" Minimum="18" Maximum="48"
                            Margin="0,8,0,0" ValueChanged="FontSize_Changed"/>
                    <TextBlock x:Name="FontPreview" Text="Привіт · Hello · 123" FontFamily="{StaticResource DisplayFont}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="SingleLine" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Біжучий рядок"/>
                            <TextBlock Text="Один рядок тексту: поточна літера стоїть по центру, набрані слова відпливають ліворуч, нові з’являються праворуч."
                                       Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Клавіатура -->
            <TextBlock Text="Клавіатура" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Вигляд клавіатури" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton x:Name="StyleStandard" Style="{StaticResource OptionRadio}" GroupName="KbStyle"
                                     Content="Стандартна" Checked="Option_Changed"/>
                        <RadioButton x:Name="StyleLaptop" Style="{StaticResource OptionRadio}" GroupName="KbStyle"
                                     Content="Ноутбук" Checked="Option_Changed"/>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="FingerColors" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Кольори пальців"/>
                            <TextBlock Text="Кожна зона пальця свого кольору, під клавіатурою — легенда. Ctrl+F" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AltLetters" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Літери іншого алфавіту"/>
                            <TextBlock Text="Дрібна латинська літера на українській розкладці і навпаки. Ctrl+K" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="FnRow" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Ряд Fn (Esc, F1–F12, Del)"/>
                            <TextBlock Text="Клацніть віртуальну клавішу Fn, щоб побачити медіафункції на F1–F12." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="FocusMode" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Режим фокусу"/>
                            <TextBlock Text="Більший текст і приглушена клавіатура, щоб менше на неї дивитися." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AutoHide" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Ховати клавіатуру, коли немає помилок"/>
                            <TextBlock Text="Після кількох чистих натискань клавіатура поступово згасає, щоб не підглядати. Помилка одразу повертає її і показує потрібну клавішу."
                                       Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Навчання -->
            <TextBlock Text="Навчання" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Одиниці швидкості" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton x:Name="UnitCpm" Style="{StaticResource OptionRadio}" GroupName="Unit"
                                     Content="Знаки за хвилину" Checked="Option_Changed"/>
                        <RadioButton x:Name="UnitWpm" Style="{StaticResource OptionRadio}" GroupName="Unit"
                                     Content="Слова за хвилину (5 знаків = 1 слово)" Checked="Option_Changed"/>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel>
                        <TextBlock x:Name="AccuracyValue" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Точність для зарахування уроку" FontWeight="SemiBold"/>
                            <TextBlock Text="Сліпий друк починається з точності: краще повільно, але без помилок." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="AccuracySlider" Style="{StaticResource FluentSlider}" Minimum="85" Maximum="100"
                            Margin="0,8,0,0" ValueChanged="Accuracy_Changed"/>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="UnlockAll" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Відкрити всі уроки"/>
                            <TextBlock Text="Можна починати з будь-якого уроку, не проходячи попередні." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="Sound" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Звук помилки"/>
                            <TextBlock Text="Тихий короткий сигнал, коли натиснуто не ту клавішу." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Text="Перерва в уроці «Без зупинки»" FontWeight="SemiBold"/>
                    <TextBlock Text="Після кожного блоку програма зупиняється і питає, чи продовжувати далі." Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="Break5" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="5" Content="5 хв" Checked="Break_Checked"/>
                        <RadioButton x:Name="Break10" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="10" Content="10 хв" Checked="Break_Checked"/>
                        <RadioButton x:Name="Break15" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="15" Content="15 хв" Checked="Break_Checked"/>
                        <RadioButton x:Name="Break20" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="20" Content="20 хв" Checked="Break_Checked"/>
                        <RadioButton x:Name="Break30" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="30" Content="30 хв" Checked="Break_Checked"/>
                        <RadioButton x:Name="Break0" Style="{StaticResource OptionRadio}" GroupName="Break" Tag="0" Content="Без перерв" Checked="Break_Checked"/>
                    </WrapPanel>

                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="VoiceToggle" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="Озвучувати текст"/>
                            <TextBlock Text="Програма проговорює речення, яке треба набрати, — можна друкувати на слух. Працює без інтернету, голосами Windows."
                                       Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock x:Name="VoiceStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock x:Name="VoiceRateValue" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Швидкість мовлення"/>
                    </DockPanel>
                    <Slider x:Name="VoiceRateSlider" Style="{StaticResource FluentSlider}" Minimum="-5" Maximum="5"
                            Margin="0,6,0,0" ValueChanged="VoiceRate_Changed"/>
                </StackPanel>
            </Border>

            <!-- Гарячі клавіші -->
            <TextBlock Text="Гарячі клавіші" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Hotkey}"><TextBlock Text="Esc"/></Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Почати поточну вправу заново" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Style="{StaticResource Hotkey}"><TextBlock Text="Enter"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Після вправи — наступний урок або новий текст" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Style="{StaticResource Hotkey}"><TextBlock Text="Ctrl+T"/></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Світла або темна тема" VerticalAlignment="Center"/>
                    <Border Grid.Row="3" Style="{StaticResource Hotkey}"><TextBlock Text="Ctrl+L"/></Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Перемкнути УКР / LAT" VerticalAlignment="Center"/>
                    <Border Grid.Row="4" Style="{StaticResource Hotkey}"><TextBlock Text="Ctrl+F"/></Border>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Кольори пальців" VerticalAlignment="Center"/>
                    <Border Grid.Row="5" Style="{StaticResource Hotkey}"><TextBlock Text="Ctrl+K"/></Border>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Літери іншого алфавіту на клавішах" VerticalAlignment="Center"/>
                    <Border Grid.Row="6" Style="{StaticResource Hotkey}"><TextBlock Text="Ctrl+Tab"/></Border>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Наступна вкладка (з Shift — попередня)" VerticalAlignment="Center"/>
                    <Border Grid.Row="7" Style="{StaticResource Hotkey}"><TextBlock Text="Win+Пробіл"/></Border>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Перемкнути розкладку Windows (системна комбінація)" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Файли -->
            <TextBlock Text="Файли" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Налаштування (config.json) і статистика (stats.json) зберігаються в папці:"/>
                    <TextBlock x:Name="DataPath" FontFamily="Consolas" Margin="0,4,0,12"
                               Foreground="{DynamicResource FgMutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource StdButton}" Content="Відкрити папку" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource StdButton}" Content="Скинути статистику" Margin="8,0,0,0" Click="ResetStats_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ResetInfo" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="2,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
