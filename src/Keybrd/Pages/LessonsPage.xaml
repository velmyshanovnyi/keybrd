<UserControl x:Class="Keybrd.Pages.LessonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список уроків -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,4">
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LayoutUk" Style="{StaticResource SegRadio}" GroupName="LessonsLayout"
                                     Content="УКР" Checked="Layout_Checked"/>
                        <RadioButton x:Name="LayoutEn" Style="{StaticResource SegRadio}" GroupName="LessonsLayout"
                                     Content="LAT" Checked="Layout_Checked"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CourseTitle" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="CourseProgress" DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,6"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,8,8" Height="4">
                <Border CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                <Border x:Name="CourseBar" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <CheckBox x:Name="UnlockAll" DockPanel.Dock="Bottom" Style="{StaticResource ToggleSwitch}" Margin="0,10,8,0"
                      Click="UnlockAll_Click">
                <StackPanel>
                    <TextBlock Text="Відкрити всі уроки"/>
                    <TextBlock Text="Якщо ви вже вмієте друкувати і хочете перейти одразу до потрібного уроку." Style="{StaticResource Muted}"/>
                </StackPanel>
            </CheckBox>
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="List" Margin="0,0,8,0"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Опис вибраного уроку -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="DStage" Style="{StaticResource Muted}" FontSize="13"/>
                <TextBlock x:Name="DTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="DDesc" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
                <WrapPanel x:Name="DKeys" Margin="0,16,0,0"/>
                <UniformGrid x:Name="MetricsRow" Columns="3" Margin="0,18,0,0">
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource SubtleHoverBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DGoal" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="мета" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource SubtleHoverBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DBest" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="найкращий результат" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource SubtleHoverBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DAttempts" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="спроб" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <StackPanel x:Name="CustomBox" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBox x:Name="CustomInput" Style="{StaticResource InputBox}" Height="180" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="CustomInput_TextChanged" LostKeyboardFocus="CustomInput_LostFocus"/>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource StdButton}" Content="Відкрити файл .txt" Click="OpenFile_Click"/>
                            <Button Style="{StaticResource StdButton}" Margin="8,0,0,0" Content="Очистити" Click="ClearCustom_Click"
                                    ToolTip="Прибрати свій текст і повернути типовий"/>
                            <Button Style="{StaticResource StdButton}" Margin="8,0,0,0" Content="Зробити типовим" Click="SaveDefault_Click"
                                    ToolTip="Зберегти цей текст у файл default_text.txt поруч із програмою — він ставитиметься за замовчуванням"/>
                        </StackPanel>
                        <TextBlock x:Name="CustomInfo" Style="{StaticResource Muted}" FontSize="13" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="DLock" Style="{StaticResource Muted}" FontSize="13" Margin="0,14,0,0"/>
                <Button x:Name="StartButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        Margin="0,16,0,0" Content="Почати урок" Click="Start_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
