<UserControl x:Class="Keybrd.Pages.TrainingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Keybrd.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Текст для набору -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LayoutUk" Style="{StaticResource SegRadio}" GroupName="Layout"
                                         Content="УКР" ToolTip="Українська (Ctrl+L)" Checked="Layout_Checked"/>
                            <RadioButton x:Name="LayoutEn" Style="{StaticResource SegRadio}" GroupName="Layout"
                                         Content="LAT" ToolTip="Латиниця (Ctrl+L)" Checked="Layout_Checked"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,24,0" VerticalAlignment="Center">
                            <Run x:Name="SpeedLabel" Text="зн/хв"/> <Run x:Name="StatSpeed" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,24,0" VerticalAlignment="Center">
                            точність <Run x:Name="StatAcc" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,24,0" VerticalAlignment="Center">
                            помилки <Run x:Name="StatErr" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,24,0" VerticalAlignment="Center">
                            час <Run x:Name="StatTime" Text="0:00" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </TextBlock>
                        <TextBlock x:Name="ExerciseName" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="вправа: часті слова"/>
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,16,0,0">
                    <!-- Видно 2–3 рядки; довший текст прокручується так, щоб поточний рядок був у полі зору. -->
                    <ScrollViewer x:Name="SampleHost" VerticalAlignment="Top" Focusable="False"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="SampleText" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"
                                   FontFamily="{StaticResource DisplayFont}"/>
                    </ScrollViewer>

                    <!-- Біжучий рядок: один рядок, поточна літера по центру, набране відпливає ліворуч. -->
                    <!-- Згасання робиться по словах у коді: слова від n−2 до n+2 чіткі, далі — блідіші. -->
                    <Canvas x:Name="TickerHost" ClipToBounds="True" Visibility="Collapsed">
                        <TextBlock x:Name="TickerText" FontFamily="{StaticResource DisplayFont}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TickerShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>

                    <!-- Результат вправи -->
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                        <TextBlock x:Name="ResultTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResultDetails" Margin="0,6,0,0" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultWorst" Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource StdButton}" Focusable="False" Click="NewText_Click">
                                <TextBlock><Run x:Name="NextLabel" Text="Новий текст"/> <Run Text="Enter" Foreground="{DynamicResource FgMutedBrush}"/></TextBlock>
                            </Button>
                            <Button x:Name="RestartButton" Style="{StaticResource StdButton}" Focusable="False" Margin="8,0,0,0" Click="Restart_Click">
                                <TextBlock><Run x:Name="RestartLabel" Text="Ще раз"/> <Run Text="Esc" Foreground="{DynamicResource FgMutedBrush}"/></TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0" Height="4">
                    <Border CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>

                <Border x:Name="LayoutWarn" Margin="0,12,0,0" CornerRadius="6" Padding="12,6"
                        Background="{DynamicResource InfoBgBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="LayoutWarnText" Foreground="{DynamicResource InfoFgBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Віртуальна клавіатура -->
        <c:KeyboardView x:Name="Kbd" Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Підказка, легенда і швидкі перемикачі -->
        <Grid Grid.Row="2" Margin="2,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,6,0,0">
                <ToggleButton x:Name="ChipVoice" Style="{StaticResource Chip}" Content="Голос" Margin="6,0,0,4"
                              ToolTip="Озвучувати текст вправи" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipHide" Style="{StaticResource Chip}" Content="Ховати клавіатуру" Margin="6,0,0,4"
                              ToolTip="Клавіатура згасає, коли немає помилок, і повертається при помилці" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipLine" Style="{StaticResource Chip}" Content="Один рядок"
                              ToolTip="Біжучий рядок: поточна літера по центру, набране відпливає ліворуч" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipFocus" Style="{StaticResource Chip}" Content="Фокус"
                              ToolTip="Більший текст і приглушена клавіатура" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipFingers" Style="{StaticResource Chip}" Content="Кольори пальців"
                              ToolTip="Ctrl+F" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipAlt" Style="{StaticResource Chip}" ToolTip="Ctrl+K" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipFn" Style="{StaticResource Chip}" Content="Ряд Fn" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipLaptop" Style="{StaticResource Chip}" Content="Ноутбук" Click="Chip_Click"/>
            </WrapPanel>
            <WrapPanel x:Name="Legend" Grid.Row="2" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</UserControl>
