<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Keybrd</AssemblyName>
    <RootNamespace>Keybrd</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Тренажер клавіатури</Product>
    <AssemblyTitle>Тренажер клавіатури</AssemblyTitle>
    <Version>1.6.1</Version>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Словники й речення для уроків — всередині exe. -->
    <EmbeddedResource Include="Data\*.txt" LogicalName="Keybrd.Data.%(Filename)%(Extension)" />
    <Resource Include="Assets\app.ico" />
    <None Remove="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Потрібен лише під час збірки; у exe нічого не додає. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Озвучення тексту: частина .NET Framework, у exe нічого не додає. -->
    <Reference Include="System.Speech" />
  </ItemGroup>

</Project>
